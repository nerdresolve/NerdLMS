# =============================================================================
# Copie para `.env.local` para desenvolver localmente:
#
#   cp infra/.env.local.example infra/.env.local
#
# Só o que diverge de produção — o `infra/.env` versionado traz o resto, e o
# último --env-file vence. `npm run up`, `logs`, `migrate` e `seed` já somam os
# dois arquivos; no servidor use as variantes `:prod`, que ignoram este.
# =============================================================================

# Domínio real aqui faria o Caddy perseguir um certificado da Let's Encrypt
# para um host que não resolve nesta máquina — e derruba o https://localhost.
SITE_ADDRESS=localhost

# Sem enviar e-mail de verdade: o link da recuperação sai em `npm run logs`.
MAIL_TRANSPORT=log

# Vazio faz o servidor deduzir a origem pelos cabeçalhos do Caddy. Fixar o
# domínio de produção geraria links de recuperação apontando para o servidor
# real a partir da máquina de desenvolvimento.
PUBLIC_ORIGIN=

STORAGE_PUBLIC_ENDPOINT=https://localhost:8444
