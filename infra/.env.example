# =============================================================================
# Copie para `.env` e preencha. `.env` NÃO é versionado (AGENTS.md §13).
#
# Cada máquina tem o seu: o do servidor leva o domínio real, o de
# desenvolvimento fica em `localhost`. Trocar isso de lugar quebra os dois.
#
# Gerar segredo forte:
#   openssl rand -base64 48
# =============================================================================

# --- Banco -------------------------------------------------------------------
POSTGRES_DB=nerdlms
POSTGRES_USER=lms_migrator
POSTGRES_PASSWORD=troque-este-valor

# A aplicação usa o papel `lms_app`, criado pela migração 002 — sem permissão
# de alterar estrutura. Nunca aponte a aplicação para o usuário dono do schema.
#
# Senha PRÓPRIA, diferente da do migrator: se a da aplicação vazar, ela não dá
# acesso de DDL. A migração 002 recebe este valor e cria o papel com ela.
APP_DB_PASSWORD=troque-este-valor-tambem
DATABASE_URL=postgres://lms_app:troque-este-valor-tambem@db:5432/nerdlms

# --- Sessão ------------------------------------------------------------------
# Trocar este valor invalida todas as sessões ativas. É o botão de emergência.
SESSION_SECRET=troque-este-valor

# --- Armazenamento de mídia --------------------------------------------------
STORAGE_ACCESS_KEY=troque-este-valor
STORAGE_SECRET_KEY=troque-este-valor
STORAGE_BUCKET=lms-media

# --- E-mail transacional ----------------------------------------------------
# Dois valores válidos:
#
#   log    grava a mensagem no log em vez de enviar. Em homologação basta para
#          testar a recuperação inteira: quem opera lê o link em `npm run logs`.
#   smtp   envia de verdade. EM PRODUÇÃO É ESTE — com `log`, a recuperação de
#          senha não chega a ninguém.
MAIL_TRANSPORT=log

# Preencher apenas com MAIL_TRANSPORT=smtp.
#
# A porta decide como o TLS começa: 465 é cifrado desde o primeiro byte, 587
# abre em claro e sobe com STARTTLS. Use a que o provedor documenta — a
# combinação errada trava a conexão sem mensagem clara.
#
# Hostinger: smtp.hostinger.com, porta 465 (SSL). A documentação deles indica
# 587 como alternativa, caso a 465 dê problema de encriptação. O usuário é o
# endereço completo da caixa, e a senha é a da caixa — não a do painel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente exibido. Vazio usa o SMTP_USER. Num SMTP autenticado o servidor
# costuma recusar remetente diferente da conta que autenticou.
SMTP_FROM=

# Endereço público, usado para montar o link do e-mail. Em branco, o servidor
# deduz pelos cabeçalhos do proxy — o que funciona atrás do Caddy.
PUBLIC_ORIGIN=

# --- Borda -------------------------------------------------------------------
# Endereço que o Caddy atende. Em desenvolvimento fica `localhost`, e o Caddy
# emite um certificado interno (o navegador avisa; é esperado).
#
# Em homologação e produção, o domínio real:
#   SITE_ADDRESS=lms.exemplo.com
#
# Com um domínio público, o Caddy emite certificado da Let's Encrypt sozinho —
# desde que a porta 443 esteja acessível e o DNS já aponte para o servidor.
SITE_ADDRESS=localhost

# Contato que a Let's Encrypt usa para avisar de certificado prestes a expirar.
# Vazio funciona em `localhost` (certificado interno), mas com domínio real vale
# preencher: é o único aviso antes de o certificado vencer.
ACME_EMAIL=
