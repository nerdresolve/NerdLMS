# =============================================================================
# Copie para `.env` e preencha. `.env` NÃO é versionado (AGENTS.md §13).
#
# Cada máquina tem o seu: o do servidor leva o domínio real, o de
# desenvolvimento fica em `localhost`. Trocar isso de lugar quebra os dois.
#
# Gerar segredo forte:
#
#   openssl rand -hex 32
#
# `-hex`, e não `-base64`: o base64 emite `/`, `+` e `=`, e a senha do banco
# entra dentro de uma URL (`DATABASE_URL=postgres://usuario:SENHA@db:...`).
# Uma barra ali encerra a autoridade da URL, a aplicação sobe e morre com
# "TypeError: Invalid URL" — sem dizer qual variável está errada.
#
# Para SESSION_SECRET, que não vai em URL nenhuma, `-base64 48` também serve.
# =============================================================================

# --- Banco -------------------------------------------------------------------
POSTGRES_DB=nerdlms
POSTGRES_USER=lms_migrator
POSTGRES_PASSWORD=troque-este-valor

# A aplicação usa o papel `lms_app`, criado pela migração 002 — sem permissão
# de alterar estrutura. Nunca aponte a aplicação para o usuário dono do schema.
#
# Senha PRÓPRIA, diferente da do migrator: se a da aplicação vazar, ela não dá
# acesso de DDL. A migração 002 recebe este valor e cria o papel com ela.
APP_DB_PASSWORD=troque-este-valor-tambem
DATABASE_URL=postgres://lms_app:troque-este-valor-tambem@db:5432/nerdlms

# --- Raiz dos segredos da aplicação -----------------------------------------
# De onde a aplicação deriva as chaves com que cifra segredos que ela precisa
# LER de volta — hoje, a senha da conta de serviço do diretório LDAP. Cada uso
# recebe uma chave própria, derivada desta por HKDF com rótulo separado.
#
# O que isso protege: o segredo sair junto com os DADOS — um backup copiado, um
# dump para investigar um chamado, uma réplica de homologação restaurada com a
# base de produção. Nesses caminhos a chave não vai junto, porque ela mora aqui
# e não no banco. Contra quem já executa código no servidor não protege, e
# nenhuma cifragem protegeria.
#
# TROCAR ESTE VALOR torna ilegível o que já foi cifrado com o anterior. A senha
# do diretório precisa ser regravada na tela de administração — a aplicação diz
# isso com todas as letras quando acontece.
#
# (A descrição anterior aqui dizia que trocá-lo invalidava as sessões ativas.
#  Não invalidava: as sessões são fichas aleatórias no banco e nunca dependeram
#  deste valor. Até esta versão, nada no código o lia.)
SESSION_SECRET=troque-este-valor

# --- Armazenamento de mídia --------------------------------------------------
STORAGE_ACCESS_KEY=troque-este-valor
STORAGE_SECRET_KEY=troque-este-valor
STORAGE_BUCKET=lms-media

# --- E-mail transacional ----------------------------------------------------
# Dois valores válidos:
#
#   log    grava a mensagem no log em vez de enviar. Em homologação basta para
#          testar a recuperação inteira: quem opera lê o link em `npm run logs`.
#   smtp   envia de verdade. EM PRODUÇÃO É ESTE — com `log`, a recuperação de
#          senha não chega a ninguém.
MAIL_TRANSPORT=log

# Preencher apenas com MAIL_TRANSPORT=smtp.
#
# A porta decide como o TLS começa: 465 é cifrado desde o primeiro byte, 587
# abre em claro e sobe com STARTTLS. Use a que o provedor documenta — a
# combinação errada trava a conexão sem mensagem clara.
#
# Hostinger: smtp.hostinger.com, porta 465 (SSL). A documentação deles indica
# 587 como alternativa, caso a 465 dê problema de encriptação. O usuário é o
# endereço completo da caixa, e a senha é a da caixa — não a do painel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente exibido. Vazio usa o SMTP_USER. Num SMTP autenticado o servidor
# costuma recusar remetente diferente da conta que autenticou.
SMTP_FROM=

# Endereço público, usado para montar o link do e-mail. Em branco, o servidor
# deduz pelos cabeçalhos do proxy — o que funciona atrás do Caddy.
PUBLIC_ORIGIN=

# --- Borda -------------------------------------------------------------------
# Endereço que o Caddy atende. Em desenvolvimento fica `localhost`, e o Caddy
# emite um certificado interno (o navegador avisa; é esperado).
#
# Em homologação e produção, o domínio real:
#   SITE_ADDRESS=lms.exemplo.com
#
# Com um domínio público, o Caddy emite certificado da Let's Encrypt sozinho —
# desde que a porta 443 esteja acessível e o DNS já aponte para o servidor.
SITE_ADDRESS=localhost

# Contato que a Let's Encrypt usa para avisar de certificado prestes a expirar.
# Vazio funciona em `localhost` (certificado interno), mas com domínio real vale
# preencher: é o único aviso antes de o certificado vencer.
ACME_EMAIL=

# Portas que o proxy publica na máquina. Só mude se 80/443 já estiverem em uso
# (outro servidor web, ou Windows/macOS sem privilégio para porta baixa):
#   HTTP_PORT=8080
#   HTTPS_PORT=8443
HTTP_PORT=80
HTTPS_PORT=443

# --- Armazenamento: o endereço que o NAVEGADOR usa ---------------------------
# O upload e o download de vídeo não passam pela aplicação: o navegador fala
# direto com o storage, através do proxy, e a URL assinada é emitida contra
# ESTE endereço.
#
# Precisa bater com o esquema da página. Uma URL `http://` dentro de uma página
# `https://` é bloqueada pelo navegador como conteúdo misto, e o vídeo não
# carrega — sem erro visível na aplicação.
#
# Em branco, a aplicação cai no STORAGE_ENDPOINT interno (`http://storage:9000`),
# que o navegador NÃO resolve — é um nome da rede do Docker. Vídeo e material
# param de carregar. Preencha sempre que a plataforma não estiver em localhost:
#   STORAGE_PUBLIC_ENDPOINT=https://lms.exemplo.com
STORAGE_PUBLIC_ENDPOINT=

# Fuso do container. Entra nos horários gravados e nos que aparecem em tela.
TZ=America/Sao_Paulo
