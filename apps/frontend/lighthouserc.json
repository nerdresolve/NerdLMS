{
  "//": "Rotina reproduzível de Lighthouse — AGENTS.md §42. Exige rede e Chrome.",
  "ci": {
    "collect": {
      "//": "Build de produção, nunca dev: o dev server não representa o real.",
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3000/login",
        "http://localhost:3000/dashboard",
        "http://localhost:3000/meus-cursos",
        "http://localhost:3000/cursos/tratamento-de-agua-fundamentos",
        "http://localhost:3000/aulas/c1m3-l5"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "//": "Metas do AGENTS.md §42. Falha relevante impede a conclusão do pipeline.",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouse" }
  }
}
